# Google Gemini image generation (keep secret; do not commit real key)
GEMINI_API_KEY=your_google_ai_key
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional advertising switches — disabled by default during testing
ADSENSE_ENABLED=0
ADSENSE_PUBLISHER=pub-1188239058737040
MONETAG_ENABLED=0

# Optional binary overrides
FFMPEG_BIN=ffmpeg
